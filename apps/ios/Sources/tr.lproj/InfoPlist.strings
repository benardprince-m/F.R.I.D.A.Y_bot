/* FRIDAY source: "FRIDAY uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "FRIDAY, takvim erişimini etkinleştirdiğinizde etkinlikleri ve planlama bağlamını göstermek için takvimlerinizi kullanır.";
/* FRIDAY source: "FRIDAY uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "FRIDAY, takvim erişimini etkinleştirdiğinizde etkinlikleri ve planlama bağlamını göstermek için takvimlerinizi kullanır.";
/* FRIDAY source: "FRIDAY uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "FRIDAY, takvim erişimini etkinleştirdiğinizde etkinlik eklemek için takvimlerinizi kullanır.";
/* FRIDAY source: "FRIDAY uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "FRIDAY; bir Gateway kurulum QR kodunu taradığınızda veya eşleştirilmiş Gateway'inizden ya da asistanınızdan bu iPhone ile fotoğraf veya kısa video çekmesini istediğinizde kamerayı kullanır. Örneğin, Gateway'inize bağlanmak veya asistanınıza bir belgeyi, aygıt ekranını ya da çalışma alanını göstermek için.";
/* FRIDAY source: "FRIDAY uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "FRIDAY, asistanı kullanırken kişileri arayabilmeniz ve onlardan bahsedebilmeniz için kişilerinizi kullanır.";
/* FRIDAY source: "FRIDAY reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "FRIDAY; istediğiniz özetleri oluşturmak ve bunları Gateway aracılığıyla yapılandırılmış yapay zekâ sağlayıcınıza göndermek için Apple Health uygulamasındaki adım, uyku, dinlenme kalp atış hızı ve antrenman verilerinizi okur.";
/* FRIDAY source: "FRIDAY does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "FRIDAY, Apple Sağlık uygulamasına veri yazmaz. İstediğiniz özetleri oluşturmak ve bunları Gateway üzerinden yapılandırılmış yapay zekâ sağlayıcınıza göndermek için salt okunur verileri kullanır.";
/* FRIDAY source: "FRIDAY discovers and connects to your FRIDAY gateway on the local network." */
"NSLocalNetworkUsageDescription" = "FRIDAY, yerel ağdaki FRIDAY gateway'inizi bulur ve ona bağlanır.";
/* FRIDAY source: "FRIDAY can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Her Zaman seçeneğini etkinleştirdiğinizde FRIDAY, konumunuzu arka planda paylaşabilir.";
/* FRIDAY source: "FRIDAY uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "FRIDAY, konum paylaşımına izin verdiğinizde konumunuzu kullanır.";
/* FRIDAY source: "FRIDAY uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "FRIDAY; gerçek zamanlı sohbet, sesle uyandırma, bas-konuş ve sesli notlar için mikrofonu kullanır.";
/* FRIDAY source: "FRIDAY may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "FRIDAY, aygıta duyarlı etkileşimleri ve otomasyonları desteklemek için hareket verilerini kullanabilir.";
/* FRIDAY source: "FRIDAY lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "FRIDAY, izin verdiğiniz fotoğrafları asistanınızın okumasına ve paylaşılacak fotoğrafları seçmenize olanak tanır.";
/* FRIDAY source: "FRIDAY uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "FRIDAY, anımsatıcı erişimini etkinleştirdiğinizde görevleri listelemek, eklemek ve tamamlamak için anımsatıcılarınızı kullanır.";
/* FRIDAY source: "FRIDAY uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "FRIDAY, konuşma modu ve sesle uyandırma için aygıt üzerindeki konuşma tanıma özelliğini kullanır.";
