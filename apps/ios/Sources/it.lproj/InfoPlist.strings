/* FRIDAY source: "FRIDAY uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "FRIDAY usa la tua posizione quando consenti la condivisione della posizione.";
/* FRIDAY source: "FRIDAY uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "FRIDAY usa il microfono per la chat in tempo reale, l'attivazione vocale, la funzione push-to-talk e i messaggi vocali.";
/* FRIDAY source: "FRIDAY may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "FRIDAY può utilizzare i dati di movimento per supportare interazioni e automazioni sensibili al dispositivo.";
/* FRIDAY source: "FRIDAY lets your assistant read photos you allow and lets you choose photos to share." */
