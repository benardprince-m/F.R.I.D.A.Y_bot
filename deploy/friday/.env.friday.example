# FRIDAY host environment (copy to .env next to docker-compose.yml).
#
# The owner is phone-only: this file is filled in ONCE, from the phone's editor, then
# left alone. Nothing here needs a laptop.
#
# Required:
#   FRIDAY_IMAGE   the published image. After the first "FRIDAY Deploy" workflow run,
#                  copy the value printed in the run summary. It looks like:
#                  ghcr.io/<your-github-username>/friday:main
#
# Everything else has a safe default.

FRIDAY_IMAGE=

# Where durable state lives on the host (config, memory, tasks, ledger). Back it up.
# FRIDAY_STATE_DIR=./state

# Timezone for logs and the heartbeat.
# FRIDAY_TZ=Africa/Nairobi

# Gateway auth token. Generate any long random string; it gates admin access to the
# Gateway. Not needed for Telegram messaging, but set it if you expose the port.
# OPENCLAW_GATEWAY_TOKEN=
